# Written for clang-tidy 23 and C++20.
#
# Every check that is switched off states why:
#   alias -- the same check runs under its primary name, which is enabled; NOLINT comments
#            name the primary only
#   style -- does not match the code style of SeisSol
#   noise -- flags code that is deliberate in SeisSol
#   TODO  -- wanted, but the code does not satisfy it yet

Checks:
  - bugprone-*
  - -bugprone-branch-clone                                         # noise: piecewise formulas, and branches that coincide only without memkind or a GPU
  - -bugprone-crtp-constructor-accessibility                       # TODO
  - -bugprone-easily-swappable-parameters                          # noise: many functions take several coordinates, indices or sizes
  - -bugprone-narrowing-conversions                                # TODO
  - -bugprone-throwing-static-initialization                       # noise: static name tables of std::string and std::vector
  - -bugprone-unchecked-optional-access                            # TODO

  # all other cert checks are aliases of checks enabled here; this one checks its own list of C functions
  - cert-err33-c

  # clang-tidy runs the static analyzer only if it is listed
  - clang-analyzer-*
  - -clang-analyzer-cplusplus.NewDeleteLeaks                       # noise: reports the aggregates of std::unique_ptr in DynamicRupture/Factory.cpp
  - -clang-analyzer-optin.performance.Padding                      # noise: the per-cell data is padded by alignas on purpose

  - clang-diagnostic-*

  - concurrency-*

  - cppcoreguidelines-*
  - -cppcoreguidelines-avoid-c-arrays                              # alias of modernize-avoid-c-arrays
  - -cppcoreguidelines-avoid-const-or-ref-data-members             # style
  - -cppcoreguidelines-avoid-do-while                              # style: iterations that run at least once
  - -cppcoreguidelines-avoid-magic-numbers                         # alias of readability-magic-numbers
  - -cppcoreguidelines-c-copy-assignment-signature                 # alias of misc-unconventional-assign-operator
  - -cppcoreguidelines-explicit-constructor                        # alias of misc-explicit-constructor
  - -cppcoreguidelines-explicit-virtual-functions                  # alias of modernize-use-override
  - -cppcoreguidelines-macro-to-enum                               # alias of modernize-macro-to-enum
  - -cppcoreguidelines-macro-usage                                 # style: build configuration and logging use macros
  - -cppcoreguidelines-narrowing-conversions                       # alias of bugprone-narrowing-conversions
  - -cppcoreguidelines-no-malloc                                   # noise: the memory allocator uses aligned and NUMA-aware allocation
  - -cppcoreguidelines-noexcept-destructor                         # alias of performance-noexcept-destructor
  - -cppcoreguidelines-noexcept-move-operations                    # alias of performance-noexcept-move-constructor
  - -cppcoreguidelines-noexcept-swap                               # alias of performance-noexcept-swap
  - -cppcoreguidelines-non-private-member-variables-in-classes     # alias of misc-non-private-member-variables-in-classes
  - -cppcoreguidelines-owning-memory                               # style: needs gsl::owner
  - -cppcoreguidelines-pro-bounds-array-to-pointer-decay           # noise: the kernel interfaces take pointers
  - -cppcoreguidelines-pro-bounds-avoid-unchecked-container-access # style: operator[] in hot loops
  - -cppcoreguidelines-pro-bounds-constant-array-index             # noise: needs gsl::at
  - -cppcoreguidelines-pro-bounds-pointer-arithmetic               # noise: buffer and kernel addressing
  - -cppcoreguidelines-pro-type-reinterpret-cast                   # noise: byte buffers for MPI, HDF5 and other I/O
  - -cppcoreguidelines-use-default-member-init                     # alias of modernize-use-default-member-init
  - -cppcoreguidelines-use-enum-class                              # TODO

  - google-*
  - -google-build-namespaces                                       # alias of misc-anonymous-namespace-in-header
  - -google-build-using-namespace                                  # style
  - -google-explicit-constructor                                   # alias of misc-explicit-constructor
  - -google-readability-braces-around-statements                   # alias of readability-braces-around-statements
  - -google-readability-casting                                    # alias of modernize-avoid-c-style-cast
  - -google-readability-function-size                              # alias of readability-function-size
  - -google-readability-namespace-comments                         # alias of llvm-namespace-comment
  - -google-readability-todo                                       # style: TODO comments carry no owner
  - -google-runtime-float                                          # noise: the I/O datatype mapping covers long double on purpose
  - -google-runtime-int                                            # TODO
  - -google-upgrade-googletest-case                                # noise: the tests use doctest, not GoogleTest

  # the other llvm checks target the LLVM API, are aliases, or enforce the LLVM header guards
  # (SeisSol checks its guards with .ci/header.py)
  - llvm-include-order
  - llvm-namespace-comment

  - misc-*
  - -misc-multiple-inheritance                                     # style
  - -misc-no-recursion                                             # noise: the recursion over materials and configurations is intended
  - -misc-non-private-member-variables-in-classes                  # style: plain data structures

  - modernize-*
  - -modernize-avoid-c-arrays                                      # noise: tensor buffers sized by the generated code
  - -modernize-return-braced-init-list                             # style
  - -modernize-use-trailing-return-type                            # TODO

  - mpi-*

  - openmp-*
  - -openmp-use-default-none                                       # noise: GCC and Clang disagree on the data-sharing of const variables

  - performance-*
  - -performance-enum-size                                         # noise: the enums are not stored in bulk
  - -performance-faster-string-find                                # alias of performance-prefer-single-char-overloads

  - portability-*
  - -portability-template-virtual-member-function                  # noise: only matters for MSVC

  - readability-*
  - -readability-convert-member-functions-to-static                # noise: members of duck-typed interfaces (layer sets, descriptors, source readers, the CPU stream runtime)
  - -readability-else-after-return                                 # style
  - -readability-function-cognitive-complexity                     # noise: long test cases and kernel setups
  - -readability-function-size                                     # TODO: needs thresholds; the default ones (800 statements) report nothing
  - -readability-identifier-length                                 # style: short names from the numerical formulae
  - -readability-magic-numbers                                     # noise: constants of the numerical methods
  - -readability-math-missing-parentheses                          # style
  - -readability-suspicious-call-argument                          # noise: points passed in permuted order on purpose (fault refinement)
  - -readability-trailing-comma                                    # style: a trailing comma makes clang-format put one element per line
WarningsAsErrors: '*'
# clang does not know this GCC coverage flag
RemovedArgs:
  - -fprofile-abs-path
CheckOptions:
  - key:             bugprone-signed-bitwise.IgnorePositiveIntegerLiterals
    value:           true
  # what cert-oop54-cpp checks
  - key:             bugprone-unhandled-self-assignment.WarnOnlyIfThisHasSuspiciousField
    value:           false
  - key:             cppcoreguidelines-special-member-functions.AllowSoleDefaultDtor
    value:           True

    # ignore Eigen, yaml-cpp, and HDF5 manually, until added to IWYU
    # Eigen needs to ignore Eigen/Core and Eigen/Eigenvalues, until we make Eigen3 5.0.0 mandatory
    # also, ignore internal GCC headers (bits/) and SYCL headers
  - key:             misc-include-cleaner.IgnoreHeaders
    value:           'Eigen/src/.*|Eigen/Core|Eigen/Eigenvalues|yaml-cpp/.*|H5.*|hdf5\.h|yateto/.*|bits/.*|external/.*|sycl/sycl\.hpp|hipSYCL/.*|AdaptiveCpp/.*'

  # literals in test data may be close to a constant without meaning it
  - key:             modernize-use-std-numbers.DiffThreshold
    value:           1e-12

  - key:             readability-identifier-naming.ClassCase
    value:           CamelCase
  - key:             readability-identifier-naming.ClassMethodCase
    value:           camelBack
  - key:             readability-identifier-naming.ConceptCase
    value:           CamelCase
  - key:             readability-identifier-naming.ConstantCase
    value:           camelBack
  - key:             readability-identifier-naming.ConstexprFunctionCase
    value:           camelBack
  - key:             readability-identifier-naming.ConstexprVariableCase
    value:           CamelCase
  - key:             readability-identifier-naming.EnumCase
    value:           CamelCase
  - key:             readability-identifier-naming.EnumConstantCase
    value:           CamelCase
  - key:             readability-identifier-naming.FunctionCase
    value:           camelBack
  - key:             readability-identifier-naming.GlobalConstantCase
    value:           CamelCase
  - key:             readability-identifier-naming.LocalConstantCase
    value:           camelBack
  - key:             readability-identifier-naming.LocalVariableCase
    value:           camelBack
  - key:             readability-identifier-naming.MemberCase
    value:           camelBack
  - key:             readability-identifier-naming.MethodCase
    value:           camelBack
  - key:             readability-identifier-naming.NamespaceCase
    value:           lower_case
  # yaml-cpp expects its conversion specializations in namespace YAML
  - key:             readability-identifier-naming.NamespaceIgnoredRegexp
    value:           '^YAML$'
  - key:             readability-identifier-naming.ParameterCase
    value:           camelBack
  - key:             readability-identifier-naming.PrivateMemberSuffix
    value:           "_"
  - key:             readability-identifier-naming.ProtectedMemberSuffix
    value:           "_"
  - key:             readability-identifier-naming.StaticConstantCase
    value:           CamelCase
  - key:             readability-identifier-naming.StructCase
    value:           CamelCase
  - key:             readability-identifier-naming.TemplateParameterCase
    value:           CamelCase
  - key:             readability-identifier-naming.TemplateTemplateParameterCase
    value:           CamelCase
  - key:             readability-identifier-naming.TypeAliasCase
    value:           CamelCase
  - key:             readability-identifier-naming.TypeAliasIgnoredRegexp
    value:           '^real$'
  - key:             readability-identifier-naming.TypedefCase
    value:           CamelCase
  - key:             readability-identifier-naming.UnionCase
    value:           camelBack
  - key:             readability-identifier-naming.VariableCase
    value:           camelBack
  - key:             readability-identifier-naming.VirtualMethodCase
    value:           camelBack
