<memory_layouts>

<!--
  The Bernstein basis. The derivatives from the basis of one degree into the one of one degree
  less have two entries per row, the elevations by one degree up to four per row; the derivative
  chain of the predictor goes through them. The derivatives in the basis of the cell, their
  product, have a few per row. What the inverse of the mass matrix enters (the weak derivatives
  kDivM, the lifts rDivM and fMrT) is dense in this basis and keeps the default layout.
-->

<matrix name="kDivMTDegree(1,0)" sparse="aligned"/>
<matrix name="kDivMTDegree(1,1)" sparse="aligned"/>
<matrix name="kDivMTDegree(1,2)" sparse="aligned"/>
