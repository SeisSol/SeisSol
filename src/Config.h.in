#ifndef SEISSOL_SRC_CONFIG_IN_H_
#define SEISSOL_SRC_CONFIG_IN_H_

// This file is automatically generated by the build process
// DO NOT EDIT!

#include "Common/ConfigValue.h"
#include "Common/Real.h"
#include "Common/Typedefs.h"
#include "Model/MaterialType.h"

#include <cstddef>

namespace seissol {

// contains everything that modifies the kernels in a numerical sense
// (i.e. for which the user might re-build)
// TODO: make concept once we switch to C++20
template <std::size_t OrderP,
          std::size_t MechanismsP,
          model::MaterialType MaterialTypeP,
          RealType PrecisionP,
          SolverType SolverP,
          DRQuadRuleType DRQuadRuleP,
          std::size_t SimulationsP>
struct ConfigOf {
    // the configuration as a runtime value; all constants below are taken from it
    static constexpr ConfigValue Value{
        OrderP, MechanismsP, MaterialTypeP, PrecisionP, SolverP, DRQuadRuleP, SimulationsP};

    static constexpr std::size_t ConvergenceOrder = Value.convergenceOrder;
    static constexpr std::size_t RelaxationMechanisms = Value.relaxationMechanisms;
    static constexpr model::MaterialType MaterialType = Value.materialType;
    static constexpr RealType Precision = Value.precision;
    static constexpr SolverType Solver = Value.solver;
    static constexpr DRQuadRuleType DRQuadRule = Value.drQuadRule;
    static constexpr std::size_t NumSimulations = Value.numSimulations;
};

// The configurations built into the executable, in the order of their ids; a type each. The first
// one, Config, is the one a run takes by default.
@SEISSOL_CONFIG_STRUCTS@
} // namespace seissol

// Expands `X(Cfg)` for every configuration built into the executable, in the order of their ids.
// A translation unit that defines templates of a configuration instantiates them through it.
#define SEISSOL_FOR_EACH_CONFIG(X) @SEISSOL_CONFIG_LIST@

// The configurations built into the executable as a comma-separated list of types, in the order of
// their ids.
#define SEISSOL_CONFIG_TYPES @SEISSOL_CONFIG_TYPE_LIST@

// The same, restricted to the configurations that advance their cells with the given solver; for
// the kernels of that solver.
#define SEISSOL_FOR_EACH_CONFIG_LINEARCK(X) @SEISSOL_CONFIGS_LINEARCK@
#define SEISSOL_FOR_EACH_CONFIG_LINEARCKANELASTIC(X) @SEISSOL_CONFIGS_LINEARCKANELASTIC@
#define SEISSOL_FOR_EACH_CONFIG_STP(X) @SEISSOL_CONFIGS_STP@

// The same, restricted to the first configuration of each material (`model::MaterialOf`); for what
// is instantiated per material.
#define SEISSOL_FOR_EACH_MATERIAL(X) @SEISSOL_CONFIGS_PER_MATERIAL@

#endif // SEISSOL_SRC_CONFIG_IN_H_
