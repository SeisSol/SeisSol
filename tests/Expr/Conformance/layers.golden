#
# What the core format makes of layers.sderiv (the specification, "Conformance"): the program as its
# fingerprint, its canonical form and its normal form, and its values at fixed points with
# the interpreter, in hexadecimal, in either compute type. SEISSOL_EXPR_GOLDEN=write writes it
# anew from what the interpreter of the build gives.
fingerprint = 7f6eb483f76b301d
canonical form
| expr1 ct8
| grid 0 inline\x1fprevious\x1fclamp\x1fstatic\x1fdata:1:8:10229417689265709364
| grid 1 inline\x1flinear\x1fclamp\x1fstatic\x1fi:linear\x1fi:nearest\x1fdata:2:6:513303969601779620
| 0=field i0
| 1=lookup 0:0 0
| 2=field i1
| 3=lookup 0:1 2
| 4=lookup 1:0 0 2
| out 1
| out 3
| out 4
normal form
| #!sderiv 1
| in x, y
| grid steps (kind = "inline",
|             components = ("rho", "mu"),
|             knots = ((-2, -1, 0.5, 3)),
|             values = ((2600, 10),
|                       (2700, 20),
|                       (3000, 40),
|                       (3300, 50)),
|             interpolation = "previous", boundary = "clamp")
| grid ramp (kind = "inline",
|            components = ("v"),
|            knots = ((-1, 0, 2), (-3, 1)),
|            values = (((0.1), (0.2), (0.7)),
|                      ((1.1), (1.3), (1.9))),
|            interpolation = ("linear", "nearest"), boundary = "clamp")
| def t0 = steps.rho(x)
| def t1 = steps.mu(y)
| def t2 = ramp.v(x, y)
| out rho = t0
| out mu = t1
| out v = t2
evaluation f64: x y -> rho mu v
