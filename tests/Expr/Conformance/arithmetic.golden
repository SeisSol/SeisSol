#
# What the core format makes of arithmetic.sderiv (the specification, "Conformance"): the program as its
# fingerprint, its canonical form and its normal form, and its values at fixed points with
# the interpreter, in hexadecimal, in either compute type. SEISSOL_EXPR_GOLDEN=write writes it
# anew from what the interpreter of the build gives.
fingerprint = 6efd0fea9abb6a19
canonical form
| expr1 ct8
| 0=field i0
| 1=field i1
| 2=pw add 0 1
| 3=pw sub 0 1
| 4=pw mul 0 1
| 5=pw div 0 1
| 6=pw sqrt 0
| 7=pw rcp 1
| 8=pw neg 0
| 9=field i2
| 10=pw add 4 9
| 11=pw mod 0 1
| 12=pw mul 2 3
| 13=pw mul 9 9
| 14=const 3f50624dd2f1a9fc
| 15=pw add 13 14
| 16=pw div 12 15
| out 2
| out 3
| out 4
| out 5
| out 6
| out 7
| out 8
| out 10
| out 11
| out 16
normal form
| #!sderiv 1
| in x, y, z
| def t0 = x + y
| def t1 = x - y
| def t2 = x * y
| def t3 = x / y
| def t4 = sqrt(x)
| def t5 = rcp(y)
| def t6 = -x
| def t7 = t2 + z
| def t8 = mod(x, y)
| def t9 = t0 * t1
| def t10 = z * z
| def t11 = t10 + 0.001
| def t12 = t9 / t11
| out sum = t0
| out difference = t1
| out product = t2
| out quotient = t3
| out root = t4
| out reciprocal = t5
| out negated = t6
| out fused = t7
| out remainder = t8
| out nested = t12
evaluation f64: x y z -> sum difference product quotient root reciprocal negated fused remainder nested
