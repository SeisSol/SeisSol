| 27=pw lt 3 26
| 28=pw mul 0 3
| 29=pw abs 28
| 30=const 4014000000000000
| 31=pw add 29 30
| 32=pw sqrt 31
| 33=pw add 9 13
| 34=const 4018000000000000
| 35=pw add 33 34
| 36=pw div 32 35
| 37=const 401c000000000000
