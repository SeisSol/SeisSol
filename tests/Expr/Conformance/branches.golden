| out 24
| out 25
| out 44
normal form
| #!sderiv 1
| in x, y
| grid g (kind = "inline",
|         components = ("v", "w"),
|         knots = ((-1, 0, 2), (-3, 1)),
|         values = (((0.1, 5), (0.2, 6), (0.7, 7)),
|                   ((1.1, 8), (1.3, 9), (1.9, 10))),
|         interpolation = "linear", boundary = "clamp")
| def t0 = lt(x, 0.5)
| def t1 = lt(y, 0)
| def t2 = g.v(x, y)
| def t3 = g.w(x, y)
| def t4 = select(t1, t2, t3)
| def t5 = abs(x)
| def t6 = t5 + 1
| def t7 = sqrt(t6)
| def t8 = abs(y)
| def t9 = t8 + 2
| def t10 = t7 / t9
| def t11 = t8 + 3
| def t12 = sqrt(t11)
| def t13 = t5 + 4
| def t14 = t12 / t13
| def t15 = t10 - t14
| def t16 = select(t0, t4, t15)
| def t17 = select(t0, t2, x)
| def t18 = lt(y, 0.25)
| def t19 = x * y
| def t20 = abs(t19)
| def t21 = t20 + 5
| def t22 = sqrt(t21)
| def t23 = t5 + t8
| def t24 = t23 + 6
| def t25 = t22 / t24
| def t26 = t5 + 7
| def t27 = sqrt(t26)
| def t28 = t8 + 8
| def t29 = t27 / t28
| def t30 = t25 + t29
| def t31 = select(t18, x, t30)
| out u = t16
| out v = t17
| out w = t31
