#
# What the core format makes of percentile.sderiv (the specification, "Conformance"): the program as its
# fingerprint, its canonical form and its normal form, and its values at fixed points with
# the interpreter, in hexadecimal, in either compute type. SEISSOL_EXPR_GOLDEN=write writes it
# anew from what the interpreter of the build gives.
fingerprint = 0fd34ec467d20537
canonical form
| expr1 ct8
| 0=const 4049000000000000
| 1=field i1
| 2=field i2
| 3=field i3
| 4=field i4
| 5=field i5
| 6=percentile 0 1 2 3 4 5
| 7=percentile 0 1 2 3 4
| 8=const 4039000000000000
| 9=percentile 8 1 2 3 4 5
| 10=const 4040a66666666666
| 11=percentile 10 1 2 3 4 5 1 2
| 12=const 0000000000000000
| 13=percentile 12 1 2 3
| 14=const 4059000000000000
| 15=percentile 14 1 2 3
| 16=field i0
| 17=pw abs 16
| 18=pw mul 17 8
| 19=percentile 18 1 2 3 4 5
| 20=percentile 16 1 2 3
| 21=percentile 18 1
| 22=const 8000000000000000
| 23=percentile 8 1 22 22
| out 6
| out 7
| out 9
| out 11
| out 13
| out 15
| out 19
| out 20
| out 21
| out 23
normal form
| #!sderiv 1
| in p, a, b, c, d, e
| def t0 = percentile(50, a, b, c, d, e)
| def t1 = percentile(50, a, b, c, d)
| def t2 = percentile(25, a, b, c, d, e)
| def t3 = percentile(33.3, a, b, c, d, e, a, b)
| def t4 = percentile(0, a, b, c)
| def t5 = percentile(100, a, b, c)
| def t6 = abs(p)
| def t7 = t6 * 25
| def t8 = percentile(t7, a, b, c, d, e)
| def t9 = percentile(p, a, b, c)
| def t10 = percentile(t7, a)
| def t11 = percentile(25, a, -0, -0)
| out median = t0
| out even = t1
| out quartile = t2
| out third = t3
| out least = t4
| out most = t5
| out given = t8
| out raw = t9
| out single = t10
| out zeros = t11
evaluation f64: p a b c d e -> median even quartile third least most given raw single zeros
