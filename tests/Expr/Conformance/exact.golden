#
# What the core format makes of exact.sderiv (the specification, "Conformance"): the program as its
# fingerprint, its canonical form and its normal form, and its values at fixed points with
# the interpreter, in hexadecimal, in either compute type. SEISSOL_EXPR_GOLDEN=write writes it
# anew from what the interpreter of the build gives.
fingerprint = dd544849e1b432a4
canonical form
| expr1 ct8
| 0=field i0
| 1=pw abs 0
| 2=pw floor 0
| 3=pw ceil 0
| 4=pw round 0
| 5=pw sign 0
| 6=field i1
| 7=pw min 0 6
| 8=pw max 0 6
| 9=pw lt 0 6
| 10=pw le 0 6
| 11=pw eq 0 6
| 12=field i2
| 13=pw and 0 12
| 14=pw or 0 12
| 15=pw select 12 0 6
| 16=const 0000000000000000
| 17=pw eq 0 16
| 18=pw lt 6 0
| out 1
| out 2
| out 3
| out 4
| out 5
| out 7
| out 8
| out 9
| out 10
| out 11
| out 13
| out 14
| out 15
| out 17
| out 18
normal form
| #!sderiv 1
| in x, y, z
| def t0 = abs(x)
| def t1 = floor(x)
| def t2 = ceil(x)
| def t3 = round(x)
| def t4 = sign(x)
| def t5 = min(x, y)
| def t6 = max(x, y)
| def t7 = lt(x, y)
| def t8 = le(x, y)
| def t9 = eq(x, y)
| def t10 = land(x, z)
| def t11 = lor(x, z)
| def t12 = select(z, x, y)
| def t13 = eq(x, 0)
| def t14 = lt(y, x)
| out a = t0
| out f = t1
| out c = t2
| out r = t3
| out s = t4
| out lo = t5
| out hi = t6
| out less = t7
| out atMost = t8
| out equal = t9
| out both = t10
| out either = t11
| out chosen = t12
| out notX = t13
| out greater = t14
evaluation f64: x y z -> a f c r s lo hi less atMost equal both either chosen notX greater
