#
# What the core format makes of types.sderiv (the specification, "Conformance"): the program as its
# fingerprint, its canonical form and its normal form, and its values at fixed points with
# the interpreter, in hexadecimal, in either compute type. SEISSOL_EXPR_GOLDEN=write writes it
# anew from what the interpreter of the build gives.
fingerprint = 77c70e05d10926ca
canonical form
| expr1 ct8
| 0=field i0
| 1=cast:f32 0
| 2=field i1
| 3=cast:f32 2
| 4=pw mul 1 3
| 5=cast 4
| 6=cast:f64 0
| 7=cast:f64 2
| 8=pw mul 6 7
| 9=cast 8
| 10=pw add 5 9
| 11=const 3fb999999999999a
| 12=pw mul 0 11
| 13=const 4008000000000000
| 14=pw div 7 13
| 15=const 7e37e43c8800759c
| 16=pw mul 0 15
| 17=const 0000000000000001
| 18=pw mul 2 17
| 19=field s0
| 20=pw add 19 6
| out 10
| out 12
| out 14
| out 16
| out 18
| out 20
| state 20 3fb999999999999a f64
normal form
| #!sderiv 1
| in x, y
| state f64 total = 0.1
| def t0 = f32(x)
| def t1 = f32(y)
| def t2 = t0 * t1
| def t3 = real(t2)
| def t4 = f64(x)
| def t5 = f64(y)
| def t6 = t4 * t5
| def t7 = real(t6)
| def t8 = t3 + t7
| def t9 = x * 0.1
| def t10 = t5 / 3
| def t11 = x * 1e+300
| def t12 = y * 5e-324
| def t13 = total + t4
| next total = t13
| out back = t8
| out tenth = t9
| out third = t10
| out big = t11
| out tiny = t12
| out sum = t13
evaluation f64: x y -> back tenth third big tiny sum
