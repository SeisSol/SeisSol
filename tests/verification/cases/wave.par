&equations
MaterialFileName = 'material.yaml'
Plasticity = 0
/

&IniCondition
cICType = 'Planarwave'
! One wavelength across a mesh of edge length 100, propagating along x. A
! planar wave is only consistent with a fully periodic mesh; on a mesh with
! free surfaces the reflection dominates, so only the periodic meshes are
! used to measure an error against the analytical solution.
kVec = 0.06283185307179587 0.0 0.0
/

&MeshNml
MeshFile = 'mesh.puml.h5'
meshgenerator = 'PUML'
PartitioningLib = 'none'
/

&Discretization
CFL = 0.5
FixTimeStep = 1e-4                             ! set by the runner
ClusteredLTS = 1                               ! GTS; LTS makes rank counts incomparable
/

&Output
OutputFile = 'output/mini'
wavefieldoutput = 0
SurfaceOutput = 0
ReceiverOutput = 1
pickdt = 1e-4
RFileName = 'receiver.dat'
xdmfWriterBackend = 'posix'
/

&AbortCriteria
EndTime = 2e-3                                 ! set by the runner
/

&Analysis
/

&Debugging
/
